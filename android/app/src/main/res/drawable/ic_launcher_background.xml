<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#0B1220"
                android:centerColor="#0D1B2A"
                android:endColor="#102A3A"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="55%p"
                android:centerX="0.5"
                android:centerY="0.42"
                android:startColor="#3322D3EE"
                android:endColor="#0022D3EE" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
</layer-list>
